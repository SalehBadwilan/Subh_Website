# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (PostgreSQL is the canonical DB for Subh) ──
# Dialect: postgres | sqlite (sqlite is a local-only fallback)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=subh_dev
DB_USER=postgres
DB_PASSWORD=
# Only used when DB_DIALECT=sqlite
DB_STORAGE=./data/subh.sqlite

# ── AI integration ──────────────────────────────────────
# Provider: Google Gemini (via its OpenAI-compatible Chat Completions endpoint).
# Get a key from https://aistudio.google.com/apikey — never commit a real key.
AI_API_KEY=
AI_PROVIDER=gemini
# Gemini's OpenAI-compatible base URL. Trailing slash is trimmed by the code.
# For OpenAI instead, set: AI_PROVIDER=openai, AI_BASE_URL=https://api.openai.com/v1
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Model available on the Gemini Free Tier.
# NOTE: gemini-2.5-flash is now 404 for new accounts ("no longer available to
# new users"). gemini-flash-lite-latest is currently callable on Free Tier and
# returns valid JSON. (OpenAI alternative: gpt-4o-mini)
AI_MODEL=gemini-flash-lite-latest
# Hard timeout (ms) for a single AI call. Clamped to [1000, 60000].
AI_TIMEOUT_MS=15000
# Max completion tokens for the AI analysis call. Clamped to [64, 4096].
AI_MAX_TOKENS=512
# Max RETRIES on transient failures (429/5xx/network/timeout). Clamped to [0,4].
# Total attempts = AI_MAX_RETRIES + 1. Permanent errors (401/403/400) are NOT retried.
AI_MAX_RETRIES=2
# Base delay (ms) for exponential backoff between retries. Clamped to [100, 5000].
# Overridden by the provider's Retry-After header when present.
AI_BASE_RETRY_DELAY_MS=500

# ── Payments ────────────────────────────────────────────
# Provider: test (default, no external keys) | moyasar
# If left as 'test' but MOYASAR_SECRET_KEY is set, moyasar is auto-detected.
PAYMENT_PROVIDER=test
# Frontend URL the gateway redirects to after payment.
PAYMENT_CALLBACK_URL=http://localhost:5173/customer/orders
# Shared secret used to verify the webhook signature (set for prod).
PAYMENT_WEBHOOK_SECRET=

# Moyasar (Saudi gateway: mada, Apple Pay, STC Pay, cards). Leave blank to use
# the built-in 'test' provider. Get keys from https://dashboard.moyasar.com
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_API_BASE_URL=https://api.moyasar.com/v1
