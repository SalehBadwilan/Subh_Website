# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (PostgreSQL is the canonical DB for Subh) ──
# Dialect: postgres | sqlite (sqlite is a local-only fallback)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=subh_dev
DB_USER=postgres
DB_PASSWORD=
# Only used when DB_DIALECT=sqlite
DB_STORAGE=./data/subh.sqlite

# ── AI integration ──────────────────────────────────────
# Read ONLY from the environment. Never commit a real key.
AI_API_KEY=
AI_PROVIDER=openai
