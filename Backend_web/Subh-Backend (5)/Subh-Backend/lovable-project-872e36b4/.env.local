# Base URL of the Subh Backend API. The admin products page and other admin
# pages call this. Vite exposes VITE_* vars to the client; this file is loaded
# automatically by Vite and is git-ignored by the project's .gitignore.
#
# Local dev default: backend runs on http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000
