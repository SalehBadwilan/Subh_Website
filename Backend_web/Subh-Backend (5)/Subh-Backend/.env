# Local development env — NOT committed.
NODE_ENV=development
PORT=3000

# Database — Supabase (PostgreSQL)
DB_DIALECT=postgres
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.gtuprmubahwbncswftbe
DB_SSL=true

# Supabase DB password (secret — never commit, never log).
DB_PASSWORD=Subh2026Market2026

# Only used when DB_DIALECT=sqlite
DB_STORAGE=./data/subh.sqlite

# AI provider = Google Gemini (OpenAI-compatible endpoint).
# Get a key from https://aistudio.google.com/apikey and paste it below.
# The SAME env var name (AI_API_KEY) is reused — no other file needs changing.
AI_API_KEY=AQ.Ab8RN6KW9ws_sCc2KWVE0A8-Ao_IYbXq55GZwvFbJV867LIiUw
AI_PROVIDER=gemini
# Gemini's OpenAI-compatible base URL (trailing slash is trimmed by the code).
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Model available on the Gemini Free Tier.
# NOTE: gemini-2.5-flash returns 404 ("no longer available to new users").
# gemini-flash-lite-latest is callable on Free Tier and returns valid JSON.
AI_MODEL=gemini-flash-lite-latest
# Hard timeout (ms) for a single AI call.
AI_TIMEOUT_MS=15000
# Max completion tokens for the AI analysis call.
AI_MAX_TOKENS=512
# Max RETRIES on transient failures (429/5xx/network/timeout).
AI_MAX_RETRIES=2
# Base delay (ms) for exponential backoff between retries.
AI_BASE_RETRY_DELAY_MS=500

# Auth — JWT signing. Change this secret in production.
JWT_SECRET=subh-dev-secret-change-me-in-production-2026
JWT_EXPIRES_IN=7d

# Payments — 'test' simulates the full flow locally with no external keys.
# Set MOYASAR_SECRET_KEY (and PAYMENT_PROVIDER=moyasar) to go live.
PAYMENT_PROVIDER=test
PAYMENT_CALLBACK_URL=http://localhost:5173/customer/orders
PAYMENT_WEBHOOK_SECRET=
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_API_BASE_URL=https://api.moyasar.com/v1

# Local dev: absolute origin for uploaded product images (isUrl rejects "localhost" hostnames).
PUBLIC_BASE_URL=http://127.0.0.1:3000
